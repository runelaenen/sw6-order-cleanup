<sw-page class="order-cleanup-index">
    <template #smart-bar-header>
        <h2>{{ $tc('order-cleanup.general.title') }}</h2>
    </template>

    <template #content>
        <sw-card-view>

            {% block order_cleanup_orders_card %}
            <sw-card :title="$tc('order-cleanup.orders.title')">

                {% block order_cleanup_orders_progress %}
                <template v-if="isLoadingOrders">
                    <p class="order-cleanup-index__progress-label">
                        {{ $tc('order-cleanup.processing', { processed: orderProcessed, total: orderTotal }) }}
                        <span class="order-cleanup-index__progress-percentage">({{ orderProgress }}%)</span>
                    </p>
                    <sw-progress-bar :value="orderProgress" />
                </template>
                {% endblock %}

                {% block order_cleanup_orders_content %}
                <template v-else>
                    <sw-alert variant="warning" :show-icon="true">
                        {{ $tc('order-cleanup.orders.warning') }}
                    </sw-alert>

                    <p>{{ $tc('order-cleanup.orders.description') }}</p>

                    <ul>
                        <li>{{ $tc('order-cleanup.orders.item.orders') }}</li>
                        <li>{{ $tc('order-cleanup.orders.item.documents') }}</li>
                        <li>{{ $tc('order-cleanup.orders.item.media') }}</li>
                        <li>{{ $tc('order-cleanup.orders.item.numberRanges') }}</li>
                    </ul>

                    <mt-button
                        variant="critical"
                        :disabled="isLoadingCustomers || !canDelete"
                        @click="showOrderConfirmModal = true">
                        {{ $tc('order-cleanup.orders.button') }}
                    </mt-button>
                </template>
                {% endblock %}

            </sw-card>
            {% endblock %}

            {% block order_cleanup_customers_card %}
            <sw-card :title="$tc('order-cleanup.customers.title')">

                {% block order_cleanup_customers_progress %}
                <template v-if="isLoadingCustomers">
                    <p class="order-cleanup-index__progress-label">
                        {{ $tc('order-cleanup.processing', { processed: customerProcessed, total: customerTotal }) }}
                        <span class="order-cleanup-index__progress-percentage">({{ customerProgress }}%)</span>
                    </p>
                    <sw-progress-bar :value="customerProgress" />
                </template>
                {% endblock %}

                {% block order_cleanup_customers_content %}
                <template v-else>
                    <sw-alert variant="warning" :show-icon="true">
                        {{ $tc('order-cleanup.customers.warning') }}
                    </sw-alert>

                    <p>{{ $tc('order-cleanup.customers.description') }}</p>

                    <ul>
                        <li>{{ $tc('order-cleanup.customers.item.customers') }}</li>
                        <li>{{ $tc('order-cleanup.customers.item.addresses') }}</li>
                        <li>{{ $tc('order-cleanup.customers.item.numberRanges') }}</li>
                    </ul>

                    <mt-button
                        variant="critical"
                        :disabled="isLoadingOrders"
                        @click="showCustomerConfirmModal = true">
                        {{ $tc('order-cleanup.customers.button') }}
                    </mt-button>
                </template>
                {% endblock %}

            </sw-card>
            {% endblock %}

        </sw-card-view>

        <sw-modal
            v-if="showOrderConfirmModal"
            :title="$tc('order-cleanup.orders.modal.title')"
            variant="small"
            @modal-close="showOrderConfirmModal = false">

            <p>{{ $tc('order-cleanup.orders.modal.body') }}</p>

            <template #modal-footer>
                <mt-button @click="showOrderConfirmModal = false">
                    {{ $tc('order-cleanup.modal.cancel') }}
                </mt-button>
                <mt-button variant="critical" @click="performOrderCleanup">
                    {{ $tc('order-cleanup.modal.confirm') }}
                </mt-button>
            </template>
        </sw-modal>

        <sw-modal
            v-if="showCustomerConfirmModal"
            :title="$tc('order-cleanup.customers.modal.title')"
            variant="small"
            @modal-close="showCustomerConfirmModal = false">

            <p>{{ $tc('order-cleanup.customers.modal.body') }}</p>

            <template #modal-footer>
                <mt-button @click="showCustomerConfirmModal = false">
                    {{ $tc('order-cleanup.modal.cancel') }}
                </mt-button>
                <mt-button variant="critical" @click="performCustomerCleanup">
                    {{ $tc('order-cleanup.modal.confirm') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
</sw-page>
